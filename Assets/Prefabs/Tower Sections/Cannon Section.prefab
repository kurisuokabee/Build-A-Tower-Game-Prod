  m_Script: {fileID: 11500000, guid: 1db0d6d16ca88144c9c77a9bbaf78c23, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  upgrades:
  - choice: 1
    upgradeName: Missile
    description: Fires cannonballs in a straight line instead of an arc.
    upgradePointCost: 1
  - choice: 3
    upgradeName: Nuke
    description: Creates larger explosions and deals 2 times more damage, but attacks slower.
    upgradePointCost: 7
  - choice: 4
    upgradeName: Cluster
    description: Splits mid-flight into 4 smaller explosive projectiles.
    upgradePointCost: 3
  - choice: 2
    upgradeName: Trebuchet
    description: Hurls a stone that stuns its target by 2 seconds on impact.
    upgradePointCost: 4
  - choice: 5
    upgradeName: Trebuchet II
    description: Shatters on impact into smaller stones that also stun targets by 2 seconds.
    upgradePointCost: 6
  - choice: 6
    upgradeName: Bombardment
    description: Targets the entity with the highest health. Adjacent cannons also attack the same target.
    upgradePointCost: 8
  selectedBranch: 0
  selectedSpecialization: 0
  upgradeIndicator: {fileID: 2085733889658794551}
